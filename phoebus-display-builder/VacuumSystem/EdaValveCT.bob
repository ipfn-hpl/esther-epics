<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>MFC El-Flow CT</name>
  <width>290</width>
  <height>140</height>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>CT EDA Valve</text>
    <x>30</x>
    <y>20</y>
    <width>110</width>
    <height>25</height>
    <font>
      <font family="Quicksand" style="REGULAR" size="16.0">
      </font>
    </font>
    <wrap_words>false</wrap_words>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button</name>
    <pv_name>${unit}:${node}:EdaCtValve:C</pv_name>
    <x>195</x>
    <y>10</y>
    <width>60</width>
    <labels_from_pv>true</labels_from_pv>
  </widget>
  <widget type="led" version="2.0.0">
    <name>Valve_LS1_ON</name>
    <pv_name>${unit}:${node}:EdaCtLs1On</pv_name>
    <bit>0</bit>
    <x>225</x>
    <y>90</y>
    <square>true</square>
  </widget>
  <widget type="led" version="2.0.0">
    <name>Valve_LS1_OFF</name>
    <pv_name>${unit}:${node}:EdaCtLs1Off</pv_name>
    <bit>0</bit>
    <x>205</x>
    <y>90</y>
    <on_color>
      <color name="STOP" red="255" green="0" blue="0">
      </color>
    </on_color>
    <square>true</square>
  </widget>
  <widget type="led" version="2.0.0">
    <name>Valve_LS2_ON</name>
    <pv_name>${unit}:${node}:EdaCtLs2On</pv_name>
    <bit>0</bit>
    <x>75</x>
    <y>90</y>
    <square>true</square>
  </widget>
  <widget type="led" version="2.0.0">
    <name>Valve_LS2_OFF</name>
    <pv_name>${unit}:${node}:EdaCtLs2Off</pv_name>
    <bit>0</bit>
    <x>95</x>
    <y>90</y>
    <on_color>
      <color name="STOP" red="255" green="0" blue="0">
      </color>
    </on_color>
    <square>true</square>
  </widget>
  <widget type="symbol" version="2.0.0">
    <name>Symbol</name>
    <pv_name>${unit}:${node}:EdaCtValve:S</pv_name>
    <symbols>
      <symbol>../images/upright_valve.svg</symbol>
      <symbol>../images/down_right_valve.svg</symbol>
    </symbols>
    <x>125</x>
    <y>40</y>
    <width>70</width>
    <height>63</height>
    <rotation>-90.0</rotation>
    <tooltip>$(pv_name)
$(pv_value)
$(actions)</tooltip>
  </widget>
</display>
